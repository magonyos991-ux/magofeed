rules_version = '2';
/*
 * ============================================================================
 *  © 2026 Magofeed — Tous droits réservés / All rights reserved.
 *  Auteur & titulaire des droits d'auteur / Copyright holder :
 *      Ilias Benabdellah — Bruxelles, Belgique.
 *  Ce code source est la propriété exclusive de son auteur. Toute copie,
 *  reproduction ou réutilisation sans son autorisation écrite est interdite.
 *  Preuve d'antériorité : historique Git horodaté + empreinte OpenTimestamps.
 * ============================================================================
 *
 * Magofeed — Règles de sécurité Firestore.
 *
 * Objectif : ouvrir juste ce qu'il faut, verrouiller le reste. En particulier :
 *  - Personne ne peut se déclarer admin (collection admins gérée à la main).
 *  - Un utilisateur ne peut promouvoir/rejeter une découverte, ni écrire une
 *    notification à autrui — seul un admin le peut.
 *  - Chacun n'écrit que son propre profil, son token push, ses votes.
 *
 * ⚠️ LIMITE HONNÊTE (Phase 1) : le solde de points (users/{uid}.points) reste
 *    écrit par le client. Un utilisateur avancé peut donc encore se donner des
 *    points via la console. Pour rendre les points INFALSIFIABLES, il faut
 *    passer les crédits côté serveur (voir points-serveur-PHASE2.js), puis
 *    remplacer la règle users.update par la version stricte en bas de ce
 *    fichier. Fais-le seulement quand la Phase 2 est déployée et testée.
 *
 * ⚠️ ADAPTE : ce projet a eu deux collections de magasins ("Stores" majuscule =
 *    données historiques, "stores" minuscule = ce que l'app écrit). Les deux
 *    sont couvertes ci-dessous. Garde celle que ton app lit réellement.
 *
 * Test avant prod : émulateur Firestore ou onglet "Règles > Terrain de jeu".
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──
    function isSignedIn() { return request.auth != null; }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function isSelf(uid) { return isSignedIn() && request.auth.uid == uid; }
    // Clés modifiées par une mise à jour
    function changed() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // ── Admins : lecture de son propre doc (pour savoir si on est admin).
    //    Aucune écriture client : on ajoute un admin à la main dans la console.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    // ── Profils utilisateurs : lisibles par tous (classement), écrits par soi.
    //    (Phase 1 : points inclus. Version stricte en bas du fichier.)
    /* Le profil d'un utilisateur est AFFICHE chez les autres (profil public,
       recherche de joueurs, classement). Sans validation, son proprietaire
       pouvait y mettre du HTML a la place d'un nombre ou d'un pseudo : le
       navigateur de celui qui regardait — administrateur compris — executait
       le contenu. L'app echappe desormais tout a l'affichage ; cette regle est
       la deuxieme barriere, celle qui empeche la valeur d'entrer. */
    function profilValide() {
      let d = request.resource.data;
      return (!('pseudo' in d) || (d.pseudo is string && d.pseudo.size() <= 24))
        && (!('points' in d) || d.points is number)
        && (!('streak' in d) || d.streak is number)
        && (!('bestStreak' in d) || d.bestStreak is number)
        && (!('confirms' in d) || d.confirms is number)
        && (!('signals' in d) || d.signals is number)
        && (!('discAccepted' in d) || d.discAccepted is number)
        && (!('favs' in d) || (d.favs is list && d.favs.size() <= 10))
        && (!('avatar' in d) || d.avatar == null
            || (d.avatar is map
                && d.avatar.keys().hasOnly(['type','v'])
                && (!('type' in d.avatar) || (d.avatar.type is string && d.avatar.type.size() <= 8))
                && (!('v' in d.avatar) || d.avatar.v is string)));
    }
    match /users/{uid} {
      allow read: if true;
      /* Les memes interdictions qu'en modification : sinon il suffisait
         d'effacer son profil et de le recreer pour repartir sans penalite. */
      allow create: if isSelf(uid) && profilValide()
        && !request.resource.data.keys().hasAny(
             ['emailDay','emailCount','emailStartDay','emailStartCount',
              'emailTestDay','emailTestCount','penalty','penaltyAt']);
      // Les compteurs d'e-mails sont ecrits par les Cloud Functions (Admin SDK,
      // qui contourne ces regles). Le client n'y touche pas, sinon il lui
      // suffirait de les remettre a zero pour contourner l'anti-spam.
      // 'penalty'/'penaltyAt' = points retires par l'anti-farm (Cloud Function
      // antiFarmRupture, Admin SDK, qui contourne ces regles). Si le client
      // pouvait y toucher, il lui suffirait de remettre le champ a zero pour
      // annuler sa sanction : toute la mecanique anti-triche ne servirait plus
      // a rien. C'est LA ligne qui rend la sanction ineffacable.
      // 'points' etait ABSENT de cette liste : n'importe qui pouvait ouvrir la
      // console de son navigateur et s'ecrire 999 999 points. Le classement
      // etait falsifiable sans effort. Desormais le score officiel n'est ecrit
      // que par les Cloud Functions (Admin SDK, qui contourne ces regles), a
      // partir des documents que les contributions laissent reellement.
      //   points        le score officiel, calcule par le serveur
      //   pointsHerites le solde fige a la bascule — personne ne perd rien
      //   pointsPreuves ce que les contributions verifiables ont rapporte
      //   pointsJour/.. le plafond quotidien anti-rafale
      //   refPoints/..  le parrainage
      //   refCode       le code court du parrain, attribue par le serveur
      allow update: if isSelf(uid)
        && profilValide()
        && !changed().hasAny(['emailDay','emailCount','emailStartDay','emailStartCount','emailTestDay','emailTestCount',
                              'penalty','penaltyAt',
                              'points','pointsHerites','pointsPreuves','pointsJour','pointsJourTotal','pointsMaj',
                              'refPoints','refCount','refAt','refCode']);
      allow delete: if isSelf(uid) || isAdmin();
      /* Sous-collections eventuelles (favoris, etc.) : reservees au proprietaire.
         ATTENTION : il faut DEUX segments ({col}/{doc=**}), pas un seul. Ecrit
         « match /{doc=**} », ce bloc couvrait aussi users/{uid} LUI-MEME et
         accordait « write » sans condition au proprietaire — ce qui annulait en
         silence tout ce qui est ecrit juste au-dessus : la validation des
         champs, l'interdiction des compteurs d'e-mails, et la ligne censee
         rendre la sanction anti-triche ineffacable. Verifie par l'emulateur :
         avant ce correctif, un utilisateur remettait sa penalite a zero. */
      match /{col}/{doc=**} {
        allow read, write: if isSelf(uid);
      }
    }

    // ── Annuaire « code court -> parrain ». Lecture ADMIN seulement : devenir
    //    connecte prend une seconde et se fait tout seul, donc une lecture
    //    ouverte aux connectes serait une lecture ouverte a tous — et
    //    permettrait de remonter d'un code partage vers un profil.
    //    C'est le serveur qui resout le code, jamais le client.
    match /refCodes/{code} {
      allow read: if isAdmin();
      allow write: if false;          // cree par la Cloud Function monCodeParrain
    }
    /* MON code de parrainage, lisible par moi seul. Il vivait dans
       users/{uid}, qui est en lecture publique pour faire marcher le
       classement : lister les profils suffisait a reconstituer les codes de
       tout le monde. La table refCodes (code vers uid) etait bien protegee,
       la table inverse ne l'etait pas. */
    match /refMine/{uid} {
      allow read: if isSelf(uid);
      allow write: if false;          // ecrit par la Cloud Function uniquement
    }

    // ── Parrainages. L'identifiant du document EST l'uid du filleul : il ne
    //    peut donc etre parraine qu'une fois dans sa vie, par construction.
    //    Le client n'ecrit RIEN ici : c'est la Cloud Function utiliserCodeParrain
    //    qui cree l'intention, et le serveur seul qui la passe a « paid ».
    //    Chacun peut lire la sienne, pour savoir ou il en est.
    match /referrals/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    // ── Sanctions anti-farm : ecrites UNIQUEMENT par la Cloud Function
    //    (Admin SDK). Personne ne peut ni en creer, ni en effacer une pour
    //    reprendre ses points. Lecture reservee a l'admin : ce n'est pas un
    //    pilori public.
    match /penalties/{pid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── Tokens push : chacun le sien. (Les Cloud Functions utilisent l'Admin
    //    SDK et contournent ces règles pour lire les tokens.)
    match /pushTokens/{uid} {
      allow read, write: if isSelf(uid);
    }

    // ── Notifications in-app : le destinataire lit les siennes et peut les
    //    marquer lues ; SEUL un admin en crée (à la promotion / au rejet photo).
    /* ══ SIGNALEMENTS ════════════════════════════════════════════════════
       Magofeed heberge deja du contenu depose par n'importe quel visiteur :
       photos de decouvertes, suggestions de photos, pseudos et avatars
       publics. Il n'existait aucun moyen de signaler quoi que ce soit — les
       deux boutons « signaler » de l'app visent un magasin qui n'existe pas
       ou une information fausse, jamais un contenu abusif.

       Le mecanisme de notification et action de l'article 16 du reglement
       europeen sur les services numeriques s'applique quelle que soit la
       taille du service : l'exemption prevue pour les micro-entreprises ne
       couvre que les articles 20 a 28. Apple et Google le demandent aussi a
       la soumission d'une application.

       ON N'EFFACE PAS AVANT D'AVOIR COPIE : le signalement porte lui-meme la
       description de ce qui est vise, pour que la preuve survive a la
       suppression du contenu d'origine. Sinon la personne qui signale perd ce
       qu'elle signalait.

       Personne ne relit ses propres signalements : les ouvrir en lecture,
       meme a leur auteur, transformerait la collection en canal (« je vois
       que tu m'as signale »). L'accuse de reception passe par userNotifs. */
    function signalementValide() {
      return request.resource.data.keys().hasOnly(
               ['par','cibleType','cibleId','motif','apercu','at','etat'])
        && request.resource.data.par == request.auth.uid
        && request.resource.data.cibleType in ['decouverte','photo','profil','commentaire']
        && request.resource.data.cibleId is string
        && request.resource.data.cibleId.size() > 0
        && request.resource.data.cibleId.size() <= 200
        /* Liste FERMEE : aucun texte libre ne peut entrer ici, donc aucun
           signalement ne peut servir a insulter la personne visee. */
        && request.resource.data.motif in
             ['alcool','sexuel','haine','harcelement','faux','spam','mineur','autre']
        && (!('apercu' in request.resource.data)
            || (request.resource.data.apercu is string
                && request.resource.data.apercu.size() <= 400))
        && request.resource.data.etat == 'nouveau';
    }
    match /abus/{id} {
      allow read:   if isAdmin();
      allow create: if isSignedIn() && signalementValide();
      /* L'administrateur marque TRAITE, il n'efface pas : le signalement et sa
         copie du contenu restent, c'est la trace de ce qui a ete decide et
         quand. La suppression reste possible pour purger apres un an. */
      allow update, delete: if isAdmin();
    }

    match /userNotifs/{docId} {
      allow read:   if isSignedIn() && resource.data.to == request.auth.uid;
      allow create: if isAdmin();
      allow update: if isSignedIn() && resource.data.to == request.auth.uid
                    && changed().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ── Catalogue : public en lecture, écrit par l'admin uniquement.
    match /catalog/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /drinkPhotos/{id} {
      allow read: if true;            // image publique d'une boisson
      allow write: if isAdmin();
    }

    // ── Découvertes communautaires : publiques ; création par tout connecté ;
    //    un utilisateur peut faire évoluer les champs "doux" (votes/photo/lieu)
    //    mais PAS promoted/rejected/by/photoRejected — réservés à l'admin.
    match /discoveries/{id} {
      allow read: if true;
      /* La creation etait ouverte a tout compte connecte, sans contrainte sur
         le nom du document, sans liste de champs, sans borne de taille et sans
         plafond de nombre. Trois consequences :
         - un compte anonyme pouvait deposer des milliers de documents, que
           l'app telechargeait tous a chaque ouverture (corrige aussi cote
           client, mais la source du probleme est ici) ;
         - le nom du document etant libre, il pouvait contenir un guillemet, et
           ce nom finissait dans un attribut HTML chez tous les utilisateurs ;
         - 'votes' n'etant pas contraint, on ecrivait directement votes:999 et
            la decouverte apparaissait « PRETE » dans le panneau admin, ce qui
            contourne d'un coup toute la mecanique de vote construite plus bas.
         Le nom du document est donc le code-barre (la convention de l'app
         depuis toujours : fbAddDiscovery ecrit doc(db,'discoveries',barcode)),
         ou l'identifiant « m + horodatage » des propositions par photo. */
      allow create: if isSignedIn()
        && !('promoted' in request.resource.data)
        && !('rejected' in request.resource.data)
        && request.resource.data.barcode == id
        && (id.matches('^[0-9]{6,20}$') || id.matches('^m[0-9]{10,16}$'))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.votes == 1
        && request.resource.data.keys().hasOnly(
             ['name','brand','cat','desc','votes','barcode','by','byPseudo',
              'createdAt','foundIn','hasPhoto','manualProposal','aiConfidence'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 60
        && (!('brand' in request.resource.data)
            || (request.resource.data.brand is string && request.resource.data.brand.size() <= 40))
        && (!('cat' in request.resource.data)
            || (request.resource.data.cat is string && request.resource.data.cat.size() <= 30))
        && (!('byPseudo' in request.resource.data)
            || (request.resource.data.byPseudo is string && request.resource.data.byPseudo.size() <= 24))
        && (!('foundIn' in request.resource.data)
            || (request.resource.data.foundIn is list && request.resource.data.foundIn.size() <= 30));
      // Anti-vandalisme : n'importe quel connecté peut faire évoluer les champs
      // "doux" (voter, joindre une photo, ajouter un lieu). MAIS renommer/re-
      // catégoriser une découverte (name/brand/cat) est réservé à SON AUTEUR
      // (by == uid) ou à l'admin — sinon un malveillant pouvait rebaptiser la
      // trouvaille d'un autre.
      /* Le champ 'votes' etait librement modifiable : la sous-collection
         votedBy dedoublonnait les votes passes par l'app, mais un seul appel a
         la console ecrivait votes:999 sans y toucher, et trois voix suffisent a
         reclamer une promotion. On impose donc deux choses a qui vote :
         l'increment vaut exactement +1, et il n'a pas deja vote. La deuxieme
         condition marche meme dans le lot atomique de l'app, ou les regles
         evaluent chaque ecriture sur l'etat d'AVANT le lot : votedBy/{uid}
         n'existe pas encore, le vote passe ; au vote suivant il existe, et les
         deux ecritures sont refusees ensemble.
         'foundIn' est borne : il decide dans quels magasins la boisson sera
         injectee lors de la promotion. */
      function voteHonnete() {
        return !changed().hasAny(['votes'])
          || (request.resource.data.votes == resource.data.votes + 1
              && !exists(/databases/$(database)/documents/discoveries/$(id)/votedBy/$(request.auth.uid)));
      }
      function foundInBorne() {
        return !('foundIn' in request.resource.data)
          || (request.resource.data.foundIn is list
              && request.resource.data.foundIn.size() <= 10);
      }
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.by == request.auth.uid
            && changed().hasOnly(['votes','hasPhoto','name','brand','cat','foundIn'])
            && voteHonnete() && foundInBorne())
        /* 'foundIn' etait modifiable par TOUT compte connecte, pas seulement
           par l'auteur. Rien ne se voyait tant que la decouverte dormait ; le
           jour ou l'administrateur la promeut, l'app boucle sur cette liste et
           injecte la boisson dans chaque magasin cite, avec une confirmation
           et une date fraiche. Deux cents magasins declaraient alors stocker
           une boisson que personne n'y a vue — et c'est l'administrateur qui
           posait le mensonge, en un clic legitime. Celui qui a scanne le
           produit reste libre de dire ou il l'a vu (branche du dessus). */
        || (isSignedIn()
            && changed().hasOnly(['votes','hasPhoto'])
            && voteHonnete());
      allow delete: if isAdmin();

      // Un vote = un doc votedBy/{uid} (dédoublonnage infalsifiable).
      match /votedBy/{uid} {
        allow read: if isAdmin();
        allow create: if isSelf(uid);   // create échoue si le doc existe déjà
        allow update, delete: if false;
      }
    }
    // Photo jointe à une découverte : lisible par les connectés (modération
    //    admin), créée par les connectés, supprimée par l'admin.
    /* « isSignedIn » n'est pas une barriere ici : l'app cree un compte anonyme
       pour chaque visiteur, automatiquement. Et la regle portait sur la
       COLLECTION : une seule requete renvoyait toutes les photos envoyees par
       la communaute, avec l'identifiant de leur auteur, y compris celles que
       l'administrateur n'a pas encore vues — donc avant toute moderation.
       L'app ne lit jamais qu'une photo a la fois, par identifiant de
       decouverte : on autorise 'get', pas 'list'. */
    match /discoveryPhotos/{id} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.by == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Suggestions (photos / formats) : proposées par les connectés,
    //    traitées par l'admin.
    match /photoSuggestions/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }
    match /formatSuggestions/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── Magasins : publics en lecture ; la communauté crée et met à jour
    //    (stock/prix) ; suppression réservée à l'admin. (ADAPTE : garde la
    //    casse réellement utilisée par ton app.)
    //    Anti-vandalisme : tout connecté peut enrichir le STOCK (drinks,
    //    confirmations, prix, horaires…). MAIS écraser l'identité du magasin
    //    (name/brand/lat/lng/emoji) est réservé à son créateur (addedBy) ou à
    //    l'admin — sinon on pouvait renommer/déplacer le magasin d'un autre.
    /* ⚠️ CERTIFICATION — la ligne la plus importante de ce fichier.
     * 'certified', 'certifiedAt' et 'owner' portent la pastille BLEUE, celle
     * que les visiteurs croient. Ils ne sont écrits que
     * par l'administrateur (approbation d'une demande shopClaims). Sans cette
     * interdiction, la console du navigateur suffisait à se certifier
     * soi-même — et la pastille ne voulait plus rien dire.
     * 'owner' commande aussi l'accès au tableau de bord commerçant : le
     * laisser libre reviendrait à donner ce tableau à qui le demande.
     *
     * 'verifiedSource' n'est plus libre : sa valeur est limitee a celle que
     * l'import automatique produit (voir sourceHonnete plus bas). Laisse libre,
     * il permettait a n'importe qui de se placer dans la file de decision de
     * l'administrateur, avec une date de verification inventee.
     */
    /* 'drinksVerified' porte le bandeau « Confirme au catalogue de l'enseigne »
       et le pin vert. Il etait modifiable par tout compte connecte : deux
       lignes dans la console suffisaient a faire dire a la carte qu'une
       boisson est confirmee dans un magasin ou personne n'a jamais rien vu —
       exactement ce que la carte ne doit jamais faire. Il est desormais refuse
       au client dans les deux sens, creation comprise : plus aucun chemin de
       l'app ne l'ecrit depuis que l'import automatique a cesse de marquer
       « verifie » un rayon devine d'apres le nom du magasin. Seuls
       l'administrateur et les Cloud Functions peuvent y toucher.
       (champsCertif() a ete retiree : elle n'etait plus appelee nulle part et
       le compilateur de regles le signalait a chaque deploiement.) */
    /* 'partner' = mise en avant payante. Il n'est pas encore en service, mais
       il est verrouille des maintenant : le jour ou il commandera une position
       privilegiee sur la carte, il ne doit pas suffire d'une ligne dans la
       console pour se l'attribuer. */
    function champsServeurStore() {
      return ['certified','certifiedAt','owner','drinksVerified','partner'];
    }
    /* 'addedBy' commandait sa PROPRE protection : la garde anti-vandalisme
       autorise a renommer ou deplacer un magasin quand on en est le createur
       (resource.data.addedBy == uid), mais rien n'empechait d'ecrire ce champ.
       En deux requetes — d'abord addedBy, ensuite le nom et les coordonnees —
       n'importe qui devenait createur du magasin d'un autre. 'geohash' rejoint
       la liste liee a la position : deplacer un magasin sans deplacer son
       geohash le rend introuvable dans sa nouvelle zone, ce qui est une autre
       facon de le faire disparaitre.

       'verifiedSource' restait libre au motif qu'il « ne porte aucune
       confiance ». C'est vrai pour la pastille bleue, mais ce champ commande
       toujours la FILE DE DECISION de l'administrateur : _repriseCandidats
       selectionne les magasins dont la valeur contient « photos », et l'app en
       extrait une date affichee comme « rayon verifie 08/2026 ». N'importe qui
       pouvait donc se placer dans cette file avec une date inventee. On
       n'interdit pas le champ — l'import automatique l'ecrit — on en limite la
       valeur a celle que cet import produit reellement. */
    function sourceHonnete() {
      return !changed().hasAny(['verifiedSource'])
        || request.resource.data.verifiedSource == 'catalogue enseigne (auto)';
    }
    match /stores/{id} {
      allow read: if true;
      /* drinksVerified rejoint la liste des champs serveur A LA CREATION aussi :
         plus aucun chemin client ne l'ecrit depuis que l'import automatique a
         cesse de marquer « verifie » un rayon devine d'apres le nom du magasin. */
      /* Aucune contrainte de type ni de taille n'existait : le decoupage a 60
         caracteres du nom vit cote client, donc rien n'empechait de creer un
         magasin invente, place n'importe ou, avec un nom de dix mille
         caracteres. Un magasin s'affiche sur la carte de tout le monde. */
      allow create: if isAdmin()
        || (isSignedIn()
            && !request.resource.data.keys().hasAny(champsServeurStore())
            && (!('addedBy' in request.resource.data)
                || request.resource.data.addedBy == request.auth.uid)
            && request.resource.data.name is string
            && request.resource.data.name.size() > 0
            && request.resource.data.name.size() <= 60
            && request.resource.data.lat is number
            && request.resource.data.lat >= -90 && request.resource.data.lat <= 90
            && request.resource.data.lng is number
            && request.resource.data.lng >= -180 && request.resource.data.lng <= 180);
      allow update: if isAdmin()
        || (isSignedIn()
            && !changed().hasAny(champsServeurStore())
            && !changed().hasAny(['addedBy','createdAt','community'])
            && sourceHonnete()
            && (resource.data.addedBy == request.auth.uid
                || !changed().hasAny(['name','brand','lat','lng','emoji','geohash'])));
      allow delete: if isAdmin();
    }
    /* « Stores » AVEC UNE MAJUSCULE : vestige supprime le 4 septembre 2026.
       Un seul document y dormait — un Carrefour d'Ixelles — et aucun code, ni
       dans l'app ni sur le serveur, ne lisait ni n'ecrivait cette collection.
       Elle avait pourtant un jeu de regles complet, copie de celui de
       « stores », qui autorisait tout compte connecte a y creer des documents.
       Un entrepot invisible et inscriptible : rien de grave puisque personne
       ne l'affiche, mais du code mort dans un fichier de securite est
       exactement ce qui empeche d'y voir clair.
       Elle tombe desormais dans le refus par defaut, tout en bas. */

    /* ── Journal des recherches (taux de réponse) ─────────────────────────
     * Anonyme par construction : boisson, zone arrondie, trouvé ou pas.
     * Chacun peut AJOUTER une ligne (c'est l'app qui écrit), personne ne
     * peut la relire sauf l'administrateur, et personne ne la modifie. */
    match /searchLog/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['d','n','lat','lng','ok','at'])
        && request.resource.data.n is string
        && request.resource.data.n.size() <= 80
        && request.resource.data.ok is bool;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ── Demandes de certification d'un commerçant ────────────────────────
     * Un document par magasin (id = storeId) : deux personnes ne peuvent pas
     * revendiquer la même boutique en parallèle.
     *
     * Le demandeur peut CRÉER sa demande, jamais la décider : 'status' doit
     * valoir 'pending' et 'by' doit être lui. Il peut relire la sienne (pour
     * savoir où en est son dossier) mais pas celle des autres — le champ
     * 'contact' contient un nom et un numéro de téléphone.
     *
     * Une demande déjà déposée ne peut pas être écrasée par quelqu'un d'autre :
     * seul l'auteur d'une demande REFUSÉE peut en redéposer une.
     */
    function pasAnonyme() {
      return isSignedIn()
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    match /shopClaims/{storeId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.by == request.auth.uid);

      /* pasAnonyme() : l'identifiant d'un compte anonyme disparaît à la
       * moindre réinstallation. Un magasin resterait attaché à un compte qui
       * n'existe plus, et son vrai gérant perdrait son tableau de bord.
       * exists(stores/...) : sans ça, on pouvait déposer des demandes sur des
       * identifiants inventés et polluer l'administration sans limite.
       */
      allow create: if pasAnonyme()
        && exists(/databases/$(database)/documents/stores/$(storeId))
        && request.resource.data.by == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.storeId == storeId
        && request.resource.data.contact is string
        && request.resource.data.contact.size() <= 80;

      /* Le RE-DÉPÔT après un refus. `storeId` est ré-ancré sur l'id du
       * document : sans cette ligne, on pouvait repointer sa demande refusée
       * vers une AUTRE boutique, y compris une déjà revendiquée. Deux demandes
       * portaient alors le même storeId, et l'administrateur qui approuvait la
       * carte du vrai commerçant exécutait celle de l'imposteur.
       */
      allow update: if isAdmin()
        || (pasAnonyme()
            && resource.data.by == request.auth.uid
            && resource.data.status == 'rejected'
            && request.resource.data.by == request.auth.uid
            && request.resource.data.status == 'pending'
            && request.resource.data.storeId == storeId);

      /* Le demandeur peut effacer sa propre demande : elle contient son nom et
       * son téléphone, le droit à l'effacement ne se discute pas. C'est aussi
       * ce que fait la suppression de compte.
       * Retirer une certification efface la demande (côté admin) : le magasin
       * redevient revendicable, ce qu'il faut quand une boutique change de
       * main.
       */
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.by == request.auth.uid);
    }

    // ── Signalements : déposés par les connectés, lus par l'admin.
    /* ── Journal des actions sensibles de l'administrateur ────────────────
     * Quoi, quand, sur combien, et le resultat. Ecrit par l'app a chaque
     * passage du garde-fou, y compris quand l'action est ANNULEE — c'est ce
     * qui permet, apres un incident, de comprendre ce qui s'est passe au lieu
     * de le deviner. Reserve a l'administrateur des deux cotes : personne
     * d'autre ne l'ecrit, personne d'autre ne le lit. Jamais modifiable :
     * un journal qu'on peut reecrire ne prouve rien. */
    match /adminLog/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.par == request.auth.uid
        && request.resource.data.action is string
        && request.resource.data.action.size() <= 60;
      allow update: if false;
      allow delete: if isAdmin();
    }

    /* ── Signalements ────────────────────────────────────────────────────
     * La creation etait ouverte a tout compte connecte SANS aucune validation
     * de champ. Or le client ecrit lui-meme `by` : n'importe qui pouvait donc
     * deposer des ruptures signees du nom d'un AUTRE utilisateur, et l'anti-farm
     * (qui retire des points a l'auteur d'une annonce contredite) devenait une
     * arme pour vider le compte d'un innocent. On exige desormais que l'auteur
     * soit celui qui ecrit, et on borne le reste. */
    match /reports/{id} {
      // Chacun peut lire les SIENS : c'est ce qui permet au serveur comme a la
      // personne de savoir ce qui a deja ete compte. Le reste reste admin.
      allow read: if isAdmin() || (isSignedIn() && resource.data.by == request.auth.uid);
      // 'counted', 'credited' et 'raison' sont poses par la Cloud Function
      // (Admin SDK) : le client ne peut pas les ecrire, sinon il lui suffirait
      // de marquer ses propres contributions comme deja payees... ou de les
      // remettre a zero pour se faire recrediter en boucle.
      allow update: if false;
      allow create: if isSignedIn()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['by','byPseudo','type','storeId','drinkId','storeName',
              'lat','lng','tz','note','createdAt'])
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 30
        && (!('note' in request.resource.data)
            || (request.resource.data.note is string
                && request.resource.data.note.size() <= 300));
      allow update, delete: if isAdmin();
    }

    // ── Veilles "préviens-moi" : chacun gère les siennes (id = uid_drinkId,
    //    champ uid == propriétaire).
    /* La regle de modification ne testait que resource.data.uid, c'est-a-dire
       la valeur AVANT ecriture. On pouvait donc creer une veille a son nom,
       puis la repointer sur quelqu'un d'autre en une deuxieme ecriture. La
       veille appartenait alors a la victime, et les Cloud Functions la croient
       sur parole : elles lui envoyaient e-mails et notifications, avec un
       libelle choisi par l'attaquant, en consommant son quota. Il faut donc
       tester les DEUX cotes. L'identifiant est aussi impose (uid_boisson,
       exactement ce que fbSyncWatch ecrit deja) : le serveur peut ainsi
       recouper le proprietaire sans faire confiance au champ. */
    match /watches/{id} {
      allow read: if isSignedIn() && resource.data.uid == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && id == request.auth.uid + '_' + string(request.resource.data.drinkId);
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Agrégats publics (compteurs de scans, notes) : lecture libre, écriture
    //    par les connectés (increment). Ce ne sont pas des données sensibles.
    /* 'write' comprenait DELETE : n'importe quel compte anonyme pouvait effacer
       stats/drinkRatings et faire disparaitre toutes les notes de la
       communaute, d'un coup et sans trace. On separe : chacun peut incrementer,
       personne ne peut effacer. */
    match /stats/{id} {
      allow read: if true;
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Métadonnées / fusions de doublons / curseurs : lecture libre,
    //    écriture admin (ou Cloud Functions via Admin SDK).
    match /meta/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /_meta/{id}   { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /drinkMerges/{id} { allow read: if true; allow write: if isAdmin(); }

    // ── Présence temps réel : chacun écrit son propre battement de cœur ;
    //    seul l'admin lit/compte (tableau de bord "en ligne maintenant").
    match /presence/{uid} {
      allow read: if isAdmin();
      allow write: if isSelf(uid);
    }

    // ── Chasses de zone : publiques en lecture (agrégées, sans noms), un
    //    connecté rejoint/quitte une chasse (met à jour son entrée seekers).
    //    On empêche d'écraser drinkId/drinkName d'autrui : création libre pour
    //    un connecté, mise à jour libre (le champ seekers.{uid} lui appartient).
    /* Le document etait entierement libre pour tout compte connecte. Trois
       consequences, toutes verifiees dans notifications-push.js :
       - on pouvait inscrire un chercheur FACTICE sans position, ce qui fait
         partir une notification vers TOUS les telephones de l'app ;
       - l'anti-spam du serveur etant range dans ce meme document (_lastPush),
         il suffisait de creer un document neuf a chaque fois pour le sauter,
         ou d'y ecrire une date lointaine pour eteindre definitivement les
         alertes d'une boisson ;
       - l'identifiant etant libre, la boucle etait illimitee.
       Desormais : le document porte le numero de la boisson, chacun ne touche
       que SA propre entree, et _lastPush est hors de portee du client. */
    /* La date d'inscription d'un chercheur (seekers.{uid}.at) est FIGEE une
       fois posee : c'est elle qui prouve qu'il chassait AVANT qu'un aidant
       reponde (voir crediterEntraide dans points-et-parrainage.js). Le client
       ne rebouge que lat/lng quand il se repositionne. Un chercheur qui
       apparait doit avoir un `at` numerique ; en quittant (null) puis en
       revenant, il repart avec une nouvelle date : c'est voulu. */
    function chercheurStable() {
      let uid = request.auth.uid;
      let avant = resource.data.seekers;
      let apres = request.resource.data.seekers;
      let existait = (uid in avant) && avant[uid] != null;
      return !(uid in apres) || apres[uid] == null
        || (existait
            ? (('at' in apres[uid]) && apres[uid].at == avant[uid].at)
            : (('at' in apres[uid]) && apres[uid].at is number));
    }
    match /hunts/{drinkId} {
      allow read: if true;
      allow create: if isSignedIn()
        && drinkId == string(request.resource.data.drinkId)
        && request.resource.data.seekers.keys().hasOnly([request.auth.uid])
        && request.resource.data.seekers[request.auth.uid].at is number
        && !('_lastPush' in request.resource.data);
      allow update: if isSignedIn()
        && request.resource.data.seekers.diff(resource.data.seekers)
             .affectedKeys().hasOnly([request.auth.uid])
        && !changed().hasAny(['_lastPush'])
        && chercheurStable();
      allow delete: if isAdmin();
    }

    // ── Avis des utilisateurs (note /5 + texte) : déposés par les connectés,
    //    lus uniquement par l'admin.
    match /feedback/{id} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // ── AUDIENCE D'UNE FICHE MAGASIN : stores/{id}/stats/{jour}
    //    Trois compteurs par jour — vues, itinéraires demandés, partages.
    //    AUCUN identifiant d'utilisateur : le commerçant voit une audience,
    //    jamais qui est passé chez lui.
    //    LECTURE réservée au propriétaire certifié (champ owner) et à l'admin.
    //    C'est un tableau de bord privé : le voisin d'en face n'a pas à lire
    //    la fréquentation d'une boutique concurrente. Le get() coûte une
    //    lecture de plus par requête — c'est le prix de la confidentialité, et
    //    il est payé une fois par ouverture du tableau de bord, pas par jour lu.
    //    ÉCRITURE ouverte aux connectés : c'est l'app de chaque visiteur qui
    //    incrémente. ⚠️ Donc gonflable par quelqu'un de déterminé, comme les
    //    points. Sans conséquence tant que le chiffre est indicatif ; à passer
    //    en Cloud Function le jour où il justifie une facture.
    /* FICHE COMMERCANT PRIVEE. merchants/{uid} liste les boutiques qu'une
       personne tient. Elle seule (et l'administrateur) peut la lire, et seul
       l'administrateur peut l'ecrire — c'est lui qui approuve une demande.
       Elle remplace le champ public stores/{id}.owner, qui reliait une
       boutique certifiee au profil personnel de son gerant : les magasins sont
       publics en lecture, les profils aussi, deux requetes suffisaient. */
    match /merchants/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if isAdmin();
    }

    /* Traces de verification par paiement. Ecrites UNIQUEMENT par la Cloud
       Function (Admin SDK, qui contourne ces regles) : c'est elle qui recoit
       la confirmation signee de Stripe. Si le client pouvait ecrire ici, il
       lui suffirait de se declarer « paye ». Aucune donnee de carte n'y
       figure — Stripe ne nous en transmet aucune. */
    match /verifications/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* Cases de 5 km deja interrogees chez Overture Maps (commerces du monde).
       Ecrites par la Cloud Function chercherCommerces uniquement : si le client
       pouvait marquer une zone « faite », il pourrait empecher tout le monde
       d'y decouvrir des commerces pendant un mois. */
    match /zonesOverture/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* Traces des dons. Meme principe que les verifications : ecrites
       UNIQUEMENT par la Cloud Function, qui recoit la confirmation signee de
       Stripe. Si le client pouvait ecrire ici, il lui suffirait de se declarer
       donateur. Aucune donnee de carte : Stripe ne nous en transmet aucune. */
    match /dons/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    /* LA CHASSE AUX CODES-BARRES.
       Une fiche de catalogue nee d'une proposition PHOTO arrive sans code : elle
       existe dans la recherche mais aucun scan ne la trouve. On demande donc a
       la communaute de les retrouver en rayon. Un document par code-barre
       propose, et il ne contient qu'une chose qui compte : QUI a confirme.

       CE QUE CES REGLES EMPECHENT, ET C'EST TOUT L'INTERET :
       - se compter deux fois (le meme uid ne peut pas s'ajouter deux fois) ;
       - ajouter QUELQU'UN D'AUTRE que soi a la liste des confirmants ;
       - toucher a autre chose que cette liste apres coup — ni la boisson visee,
         ni le code, ni l'etat. Le lien propose ne peut donc pas etre detourne
         vers une autre boisson une fois les confirmations reunies.
       Poser reellement le code sur la fiche catalogue reste hors de portee du
       client (catalog est en ecriture isAdmin()) : c'est la Cloud Function qui
       le fait, a deux confirmations, avec l'Admin SDK. */
    match /chasseCodes/{barcode} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['drinkId','drinkName','barcode','par','etat','createdAt'])
        && request.resource.data.par == [request.auth.uid]
        && request.resource.data.etat == 'attente'
        && request.resource.data.barcode is string
        && request.resource.data.barcode.size() <= 20;
      allow update: if isSignedIn()
        && resource.data.etat == 'attente'
        && !(request.auth.uid in resource.data.par)
        && request.resource.data.par == resource.data.par.concat([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['par']);
      allow delete: if isAdmin();
    }

    /* « Cette personne a soutenu le projet. » Son SEUL usage dans l'app : ne
       plus lui remettre la carte de don sous le nez, et lui dire merci. Ce
       document ne pose aucun droit et ne debloque rien — un don qui debloque
       quelque chose n'est plus un don, c'est un achat. Chacun lit le sien ;
       personne ne peut l'ecrire, sinon il suffirait de se declarer soutien
       pour faire taire la demande (ce qui, au fond, serait sans gravite —
       mais une regle qui laisse ecrire n'importe quoi finit toujours par
       servir a autre chose). */
    match /soutiens/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /stores/{storeId}/stats/{jour} {
      /* On accepte les deux : la fiche privee (nouveau), et l'ancien champ
         public pour les magasins certifies avant le changement, qui ne doivent
         pas perdre leur tableau de bord du jour au lendemain. */
      allow read: if isAdmin()
        || (isSignedIn()
            && (
              (exists(/databases/$(database)/documents/merchants/$(request.auth.uid))
               && get(/databases/$(database)/documents/merchants/$(request.auth.uid)).data.stores.hasAny([storeId]))
              || get(/databases/$(database)/documents/stores/$(storeId)).data.owner == request.auth.uid
            ));
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── DEMANDE : ce que les gens cherchent, et ce qu'ils ne trouvent pas.
    //    Ces documents ne contiennent AUCUN identifiant d'utilisateur : ce sont
    //    des compteurs par (jour, zone d'environ 5 km, boisson). Personne ne
    //    peut y lire le parcours de qui que ce soit — c'est pour ça qu'ils
    //    peuvent être exploités, et même vendus agrégés, sans problème.
    //    Lecture réservée à l'admin : c'est l'actif commercial de Magofeed,
    //    inutile de l'offrir à un concurrent qui saurait lire une base.
    //    ⚠️ LIMITE (comme les points) : le compteur est incrémenté par le
    //    client, donc gonflable par quelqu'un de déterminé. Sans importance
    //    pour une lecture interne ; à passer en Cloud Function le jour où ce
    //    chiffre part chez un client payant.
    match /demand/{id} {
      allow read: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // ── Reliquat de l'ancien crawler : verrouillé.
    match /crawler/{id} { allow read: if isAdmin(); allow write: if false; }

    // ── Tout le reste : refusé par défaut (rien n'est laissé ouvert par oubli).
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

/*
 * ============================================================================
 * VERSION STRICTE des points (à activer en PHASE 2, une fois les crédits
 * passés côté serveur). Remplace le bloc users/{uid} ci-dessus par celui-ci :
 *
 *   match /users/{uid} {
 *     allow read: if true;
 *     allow create: if isSelf(uid);
 *     allow update: if isSelf(uid)
 *       // le client ne peut PLUS toucher aux champs sensibles : le serveur seul
 *       && !changed().hasAny(['points','discAccepted','trust','confirms','signals']);
 *     allow delete: if isSelf(uid) || isAdmin();
 *     match /{doc=**} { allow read, write: if isSelf(uid); }
 *   }
 *
 * À ce moment-là, TOUS les crédits de points doivent venir d'une Cloud Function
 * (Admin SDK, qui contourne ces règles). Sinon les points cessent d'augmenter.
 * ============================================================================
 */
