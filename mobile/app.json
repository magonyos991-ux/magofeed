{
  "expo": {
    "name": "Magofeed",
    "slug": "magofeed",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f0e9",
    "ios": {
      "bundleIdentifier": "com.magofeed.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Magofeed utilise ta position pour trouver les magasins les plus proches qui ont ta boisson."
      }
    },
    "android": {
      "package": "com.magofeed.app",
      "adaptiveIcon": {
        "backgroundColor": "#f4f0e9",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        { "locationWhenInUsePermission": "Magofeed utilise ta position pour trouver les magasins les plus proches qui ont ta boisson." }
      ]
    ]
  }
}
